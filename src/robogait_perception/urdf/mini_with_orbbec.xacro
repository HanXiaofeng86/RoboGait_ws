<?xml version="1.0"?>
<!-- Mini chassis from roverrobotics_description + Femto Mega on the payload. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_mini">
    <xacro:include filename="$(find roverrobotics_description)/urdf/mini.urdf"/>
    <xacro:include filename="$(find robogait_perception)/urdf/orbbec_gimbal.urdf"/>
</robot>
