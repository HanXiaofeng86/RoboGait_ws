<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_slam_mapping</name>
  <version>0.1.0</version>
  <description>
    Lightweight online SLAM for Rover Mini: hardware + EKF + slam_toolbox + pad.
    Does not start full Nav2/MPPI (use robot_mppi_navigation for daily navigation).
  </description>
  <maintainer email="robogait@todo.todo">robogait</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_mppi_navigation</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>roverrobotics_driver</exec_depend>
  <exec_depend>roverrobotics_input_manager</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
