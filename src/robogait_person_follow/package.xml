<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robogait_person_follow</name>
  <version>0.1.0</version>
  <description>Mode B: person follow. B1/B2 send a Nav2 goal; B3 is straight distance-only drive (Python).</description>
  <maintainer email="robogait@todo.todo">robogait</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robogait_person_interfaces</exec_depend>
  <exec_depend>robogait_perception</exec_depend>
  <exec_depend>robogait_gimbal</exec_depend>
  <exec_depend>robot_mppi_navigation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
